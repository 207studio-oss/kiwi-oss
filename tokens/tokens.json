{
  "brief_guard": {
    "description": "Task-start brief enforcement for acting tools. A caller with no context_for brief within window_min gets a brief_guard warning (warn) or a refusal (block); every guarded call is appended to the brief ledger.",
    "mode": "warn",
    "risky_keywords": [
      "payment",
      "결제",
      "delete",
      "삭제",
      "secret",
      "비밀",
      "token",
      "토큰",
      "password",
      "비밀번호",
      "send to 오너",
      "오너",
      "external",
      "외부"
    ],
    "routing_answer": "진행: 저위험 전달·라우팅 작업",
    "routing_confidence": 0.85,
    "routing_keywords": [
      "routing",
      "route",
      "routes",
      "relay",
      "relays",
      "relayed",
      "relaying",
      "forward",
      "forwards",
      "forwarded",
      "forwarding",
      "hand off",
      "handoff",
      "hand-offs",
      "전달",
      "라우팅",
      "넘기기",
      "배정"
    ],
    "window_min": 60
  },
  "claim": {
    "default_hours": 4,
    "default_status": "active",
    "events": [
      "claim.registered",
      "claim.renewed",
      "claim.released"
    ],
    "states": [
      "active",
      "expired"
    ]
  },
  "color": {
    "accent": {
      "base": "#2F6F4E",
      "hover": "#25573D",
      "on": "#FFFFFF",
      "pressed": "#1C422F"
    },
    "border": {
      "strong": "#C9C9C2",
      "subtle": "#E3E3DF"
    },
    "button_depth": {
      "accent": "#1d4bc0",
      "danger": "#a52a3d",
      "dark": "rgba(0,0,0,.5)",
      "default": "rgba(32,49,75,.28)",
      "mix_accent": "color-mix(in srgb,var(--accent) 70%,#071a3d)",
      "mix_current": "color-mix(in srgb,currentColor 35%,transparent)",
      "mix_danger": "color-mix(in srgb,#d94255 70%,#3a0710)"
    },
    "state": {
      "danger": "#B3261E",
      "info": "#1F5FA8",
      "success": "#2E7D4F",
      "warning": "#B26A00"
    },
    "surface": {
      "base": "#FFFFFF",
      "raised": "#F7F7F5",
      "sunken": "#EDEDEA"
    },
    "text": {
      "inverse": "#FFFFFF",
      "primary": "#111111",
      "secondary": "#5C5C5C"
    }
  },
  "motion": {
    "button_spring": {
      "ios": {
        "damping": 14,
        "mass": 1,
        "overshoot_scale": 1.04,
        "press_scale": 0.92,
        "stiffness": 280,
        "type": "spring"
      },
      "reduced_motion": {
        "keep": [
          "color",
          "shadow"
        ],
        "motion": "none"
      },
      "source": "rules/app-ui-buttons.md",
      "web": {
        "deprecated": {
          "hover_wobble_deg": "wobble_deg_1..wobble_deg_4",
          "overshoot_scale": "pop_keyframe_peak_scale",
          "press_scale": "press_scale_x, press_scale_y",
          "shadow_press_ratio": "depth_rest_px, depth_hover_px, depth_press_px"
        },
        "depth_hover_px": 6,
        "depth_press_px": 1,
        "depth_rest_px": 4,
        "duration_ms": 420,
        "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "hover_lift_px": -2,
        "hover_scale": 1.03,
        "hover_wobble_deg": 1.5,
        "overshoot_scale": 1.04,
        "pop_duration_ms": 450,
        "pop_easing": "linear(0,1.3 45%,.9 75%,1 100%)",
        "pop_from_scale": 0.6,
        "pop_keyframe_dip_scale": 0.96,
        "pop_keyframe_peak_scale": 1.12,
        "press_duration_ms": 70,
        "press_easing": "ease-out",
        "press_offset_px": 3,
        "press_scale": 0.92,
        "press_scale_x": 1.08,
        "press_scale_y": 0.88,
        "release_duration_ms": 520,
        "release_easing": "cubic-bezier(.3,1.8,.5,1)",
        "shadow_duration_ms": 220,
        "shadow_easing": "ease-out",
        "shadow_press_ratio": 0.5,
        "wobble_deg_1": -3,
        "wobble_deg_2": 2.5,
        "wobble_deg_3": -1.5,
        "wobble_deg_4": 0.5
      }
    },
    "duration_ms": {
      "base": 200,
      "fast": 120,
      "slow": 320
    },
    "easing": {
      "emphasized": "cubic-bezier(0.2, 0, 0, 1.2)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "radius": {
    "lg": 16,
    "md": 10,
    "pill": 999,
    "sm": 6
  },
  "runtime": {
    "description": "Adaptive resource policy for local background services (kiwi tray index, mem agents). Services read this via kiwi-live tokens_get and re-apply on token.changed; no fixed intervals in code.",
    "dev_activity": {
      "build_processes": [
        "cargo",
        "rustc",
        "swift-frontend",
        "swift-build",
        "msbuild",
        "dotnet",
        "tsc",
        "vite",
        "node",
        "xcodebuild",
        "gradle"
      ],
      "description": "Event sources that switch to the 'active'/'loaded' state instantly (process start/stop events, not timers).",
      "focus_repo": "pause indexing under the repo being worked on (from foreground IDE/harness cwd) until its activity ends",
      "harness_processes": [
        "codex",
        "claude",
        "dsh",
        "aside"
      ],
      "ide_processes": [
        "Code",
        "Cursor",
        "devenv",
        "idea64"
      ],
      "on_build_or_test": "loaded",
      "on_harness_or_ide": "active"
    },
    "fallback_full_rescan_hours": 24,
    "never_wake_wsl": true,
    "state_detection": {
      "hysteresis_seconds": 30,
      "system_loaded_cpu_percent": 70,
      "system_loaded_memory_percent": 85,
      "user_idle_after_seconds": 120
    },
    "states": {
      "active": {
        "embed_batch": 8,
        "index_workers": 1,
        "process_priority": "idle",
        "rescan": "on_event",
        "wsl_probe": "on_demand"
      },
      "idle": {
        "embed_batch": 32,
        "index_workers": 2,
        "process_priority": "below_normal",
        "rescan": "on_event",
        "wsl_probe": "on_demand"
      },
      "loaded": {
        "embed_batch": 0,
        "index_workers": 0,
        "process_priority": "idle",
        "rescan": "deferred",
        "wsl_probe": "off"
      }
    }
  },
  "self_improve": {
    "brief_feedback": {
      "days": 30,
      "max_score": 5.0,
      "max_shift": 2,
      "missing_min_count": 3,
      "noise_weight": 1.0,
      "useful_weight": 1.0
    },
    "calibration": {
      "buckets": [
        0.0,
        0.5,
        0.6,
        0.7,
        0.8,
        0.9,
        1.0
      ],
      "days": 30,
      "min_bucket": 3,
      "min_samples": 20,
      "step": 0.05,
      "target_accuracy": 0.9,
      "threshold": 0.75,
      "threshold_max": 0.95,
      "threshold_min": 0.5
    },
    "description": "Self-improvement loops (lessons->rule proposals, brief feedback, decide/ask calibration). Thresholds, weights and bounds live here; code only has fallbacks.",
    "rule_proposals": {
      "area_rules": {
        "all": "rules/agent-procedure.md",
        "code": "rules/code-review.md",
        "dev": "rules/code-review.md",
        "general": "rules/lessons.md"
      },
      "default_rule": "rules/lessons.md",
      "ignore_status": [
        "retired"
      ],
      "min_group": 3,
      "similarity": 0.4,
      "update_overlap": 0.5
    }
  },
  "source": "Example values. One token source: rules and app code reference these paths instead of literal values; change them with kiwi-live token_set and receive token.changed.",
  "spacing": {
    "lg": 16,
    "md": 12,
    "sm": 8,
    "unit": "pt",
    "xl": 24,
    "xs": 4,
    "xxl": 32
  },
  "task": {
    "states": [
      "pending",
      "active",
      "blocked",
      "done",
      "failed",
      "cancelled",
      "rollback_complete"
    ]
  },
  "updated": "2026-10-24",
  "version": 1,
  "webhook": {
    "events": [
      "claim.registered",
      "claim.renewed",
      "claim.released",
      "token.changed",
      "brief.missing",
      "rule.proposed",
      "kiwi.improved",
      "oss.released"
    ],
    "external_events": [
      "kiwi.improved",
      "oss.released"
    ],
    "retries": 3,
    "signature_algorithm": "HMAC-SHA256",
    "signature_header": "X-Kiwi-Signature",
    "signed_payload": "timestamp + '.' + raw_body",
    "timeout_seconds": 5,
    "timestamp_header": "X-Kiwi-Timestamp"
  }
}
